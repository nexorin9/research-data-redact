# 凭据位模板 —— 复制为 .env 后填入真实值；.env 已被 .gitignore 排除，不得提交。
# 所有值一律从环境变量读取，代码中不得出现任何硬编码密钥。

# ---- 出站读：HIS 患者主索引（只读）----
# 未配置时该通道置「挂起」并告警，不静默改指本地替身
HIS_BASE_URL=https://his.example.internal
HIS_API_TOKEN=<占位：HIS 患者主索引接口令牌>

# ---- 出站写：科研数据平台（数据集交付 + 还原回执）----
# 未配置时该通道置「挂起」并告警，不静默改指本地替身
RESEARCH_DATA_BASE_URL=https://research-data.example.internal
RESEARCH_DATA_TOKEN=<占位：科研数据平台接口令牌>

# ---- 一致代号 ----
# 同一患者跨材料代号恒等所依赖的密钥；缺失时报错，不降级为无密钥哈希
PSEUDONYM_HMAC_KEY=<占位：一致代号 HMAC 密钥，≥32 字节>
# 密钥版本号，写入交付体的 pseudonymization.key_id
PSEUDONYM_KEY_ID=<占位：例如 key-2026-10>

# ---- 对照索引加密存储 ----
# 留空时由 $PSEUDONYM_HMAC_KEY 派生（会在日志中标注派生来源）
INDEX_ENCRYPTION_KEY=<占位：对照索引加密密钥，可留空由主密钥派生>

# ---- 出站推：企业微信机器人 ----
# 未配置时推送通道置「挂起」并告警
WECOM_WEBHOOK_URL=<占位：企业微信群机器人 webhook 地址>

# ---- 出站通用 ----
# 交付体里 storage_uri / manifest_uri 的基地址（平台从共享暂存区或对象存储取件）。
# 留空时写成本机暂存路径的 file:// URI（如实反映「件还在本机」）
RESEARCH_DATA_STORAGE_BASE=<占位：例如 https://research-data.example.internal/staging/>
# 出站调用超时（秒），三个通道共用
RESEARCH_OUTBOUND_TIMEOUT=10

# ---- 还原授权 ----
# 可授权还原的人员名单（逗号分隔，中英文逗号都认）。
# 名单为空 = 无人可授权：任何还原请求都不得通过（不会默认放行）
RESTORE_AUTHORIZER_LIST=<占位：例如 张主任,李质控>

# ---- 本地运行路径 ----
# 科研交付目录（守护进程监听的 inbox 根目录）
RESEARCH_DELIVERY_DIR=./var/inbox
# 脱敏产物与命中清单输出目录
RESEARCH_OUTPUT_DIR=./var/outbox
# SQLite 批次台账路径
RESEARCH_LEDGER_DB=./var/ledger.sqlite3
# 对照索引文件路径（与交付物目录分离存放）
RESEARCH_INDEX_FILE=./var/index/pseudonym_index.enc
# 策略表路径
RESEARCH_POLICY_FILE=./policy/research.yaml
# 策略表档位（profiles）：留空 = 默认档（占位符替换）；
# 填 pseudonym = 一致代号档（同一患者跨材料代号恒等，需配 PSEUDONYM_HMAC_KEY）
RESEARCH_POLICY_PROFILE=
# 策略快照目录（每批留一份「这一批用哪一版策略脱的」，事后可重放核对）。
# 留空 = 跟着批次台账走（台账旁边建 snapshots/）。
# 快照里**不得**出现任何密钥：策略表里若写了凭据，落盘时会被拒绝并报错。
RESEARCH_SNAPSHOT_DIR=
# 批次告警台账路径（残留自检未通过时按批次落一条告警）
RESEARCH_ALERT_LEDGER=./var/alerts.jsonl
